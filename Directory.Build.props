<Project>

  <PropertyGroup>
    <!--
      Numéro de version unique du projet, centralisé ici pour
      MetaExtract.Core et MetaExtract.App (les deux csproj héritent
      automatiquement de ce fichier, car il est à la racine du dépôt).

      Suit le Versioning Sémantique (https://semver.org) : MAJOR.MINOR.PATCH
        - MAJOR : changement incompatible / réécriture importante
        - MINOR : nouvelle fonctionnalité, rétrocompatible
        - PATCH : correction de bug, rétrocompatible

      Ne pas modifier cette valeur à la main : elle est incrémentée
      automatiquement par scripts\release.ps1 au moment de créer une
      nouvelle release (tag git vX.Y.Z).
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>

</Project>
