<Window x:Class="MetaExtract.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Height="260" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Assets/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Emplacement de mediainfo.exe (installation MediaInfo existante) :"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathTextBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Parcourir..." Padding="10,4" Click="BrowseButton_Click"/>
        </Grid>

        <TextBlock x:Name="ValidationText" Grid.Row="2" Margin="0,8,0,0" Foreground="Firebrick" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="3" Margin="0,20,0,8" TextWrapping="Wrap"
                   Text="Reconnaissance des noms de fichiers (saison, manche, Grand Prix, type, chaîne, langue) : les règles sont dans des fichiers texte modifiables, propres à votre façon de nommer vos fichiers."/>
        <Button Grid.Row="4" Content="Ouvrir le dossier de configuration..." Padding="10,4"
                HorizontalAlignment="Left" Click="OpenConfigFolderButton_Click"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Padding="14,4" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Enregistrer" Padding="14,4" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
